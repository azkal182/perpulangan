// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model User {
    id            String    @id
    name          String
    email         String
    emailVerified Boolean   @default(false)
    image         String?
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt
    sessions      Session[]
    accounts      Account[]

    username        String?
    displayUsername String?
    role            String    @default("korda")
    banned          Boolean   @default(false)
    banReason       String?
    banExpires      DateTime?
    kordapic        Korda?    @relation("KordaPIC")
    korwilpic       Korwil?   @relation("KorwilPIC")

    @@unique([email])
    @@unique([username])
    @@map("user")
}

model Session {
    id             String   @id
    expiresAt      DateTime
    token          String
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt
    ipAddress      String?
    userAgent      String?
    impersonatedBy String?
    userId         String
    user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([token])
    @@index([userId])
    @@map("session")
}

model Account {
    id                    String    @id
    accountId             String
    providerId            String
    userId                String
    user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    accessToken           String?
    refreshToken          String?
    idToken               String?
    accessTokenExpiresAt  DateTime?
    refreshTokenExpiresAt DateTime?
    scope                 String?
    password              String?
    createdAt             DateTime  @default(now())
    updatedAt             DateTime  @updatedAt

    @@index([userId])
    @@map("account")
}

model Verification {
    id         String   @id
    identifier String
    value      String
    expiresAt  DateTime
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    @@index([identifier])
    @@map("verification")
}

model Student {
    id     String  @id @default(uuid())
    idApi  String? @unique
    nis    String? @unique
    name   String
    gender String

    fromApi Boolean        @default(true)
    source  StudentSource?

    status Boolean
    ttl    String?

    photoUrl String?

    parrentPhone String?
    dormitory    String?

    fullAddress String?
    // village     String?
    province    Province? @relation(fields: [provinceId], references: [id])
    provinceId  Int?
    regency     Regency?  @relation(fields: [regencyId], references: [id])
    regencyId   Int?
    district    District? @relation(fields: [districtId], references: [id])
    districtId  Int?
    village     Village?  @relation(fields: [villageId], references: [id])
    villageId   Int?

    registrations Registration[]

    @@index([status])
    @@index([name])
    @@index([regencyId])
    @@index([dormitory])
    @@index([fromApi])
    @@index([source])
}

model Province {
    id   Int    @id @default(autoincrement())
    name String
    code String

    regencies Regency[]
    Student   Student[]

    @@index([name])
}

model Regency {
    id        Int        @id @default(autoincrement())
    name      String
    label     String?
    type      String?
    code      String
    fullCode  String
    districts District[]

    provinceId Int
    province   Province @relation(fields: [provinceId], references: [id])
    kordaId    String?
    korda      Korda?   @relation(fields: [kordaId], references: [id], onDelete: SetNull)

    Student Student[]

    @@index([provinceId])
    @@index([kordaId])
    @@index([name])
    @@index([label])
}

model District {
    id       Int       @id @default(autoincrement())
    name     String
    code     String
    fullCode String
    villages Village[]

    regencyId Int
    regency   Regency   @relation(fields: [regencyId], references: [id])
    Student   Student[]

    @@index([regencyId])
    @@index([name])
}

model Village {
    id         Int    @id @default(autoincrement())
    name       String
    code       String
    fullCode   String
    postalCode String

    districtId Int
    district   District  @relation(fields: [districtId], references: [id])
    students   Student[]

    @@index([districtId])
    @@index([name])
}

model SyncLog {
    id          String    @id @default(uuid())
    key         String    @unique // contoh: "students"
    lastSyncAt  DateTime?
    lastStatus  String? // "success" | "failed"
    lastSummary Json? // simpan ringkasan import (inserted/updated/failed, dll)
    updatedAt   DateTime  @updatedAt
    createdAt   DateTime  @default(now())

    @@index([key])
}

enum StudentSource {
    DAFU
    MUSA
}

enum EventStatus {
    DRAFT
    ACTIVE
    COMPLETED
}

model Event {
    id        String      @id @default(uuid())
    name      String
    startDate DateTime
    endDate   DateTime
    status    EventStatus @default(DRAFT)
    createdAt DateTime    @default(now())
    updatedAt DateTime    @updatedAt

    registrations Registration[]
    buses         Bus[]

    // Tracker API sync status
    trackerEventId String?   @unique // Event ID from tracker API
    trackerSyncAt  DateTime? // Last sync timestamp

    @@index([status])
    @@index([startDate])
}

model Korwil {
    id   String @id @default(uuid())
    name String

    // Placeholder sebelum punya user
    picName  String?
    picPhone String?

    picUserId String? @unique
    picUser   User?   @relation("KorwilPIC", fields: [picUserId], references: [id], onDelete: SetNull)

    kordas Korda[]
    buses  Bus[]

    updatedAt DateTime @updatedAt
    createdAt DateTime @default(now())
}

model Korda {
    id   String @id @default(uuid())
    name String

    picName  String?
    picPhone String?

    picUserId String? @unique
    picUser   User?   @relation("KordaPIC", fields: [picUserId], references: [id], onDelete: SetNull)

    korwilId   String?
    korwil     Korwil?     @relation(fields: [korwilId], references: [id], onDelete: SetNull)
    regencies  Regency[]
    dropPoints DropPoint[]

    outboundRegistrations Registration[] @relation("OutboundKorda")
    returnRegistrations   Registration[] @relation("ReturnKorda")
    busKordas             BusKorda[]

    updatedAt DateTime @updatedAt
    createdAt DateTime @default(now())
}

model Bus {
    id       String @id @default(uuid())
    label    String // e.g., "Bus 01 - Agra Mas + Kumaci"
    capacity Int    @default(0) // Kapasitas maksimal penumpang

    // Tracker integration
    trackerId String? @unique // ID from tracker API

    // Many-to-many: 1 bus bisa untuk banyak korda
    kordas BusKorda[]

    // Optional: grouping by Korwil
    korwilId String?
    korwil   Korwil? @relation(fields: [korwilId], references: [id], onDelete: SetNull)

    eventId String
    event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

    isActive Boolean @default(true)

    // Passengers assigned to this bus
    outboundRegistrations Registration[] @relation("OutboundBus")
    returnRegistrations   Registration[] @relation("ReturnBus")

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([eventId])
    @@index([korwilId])
    @@index([trackerId])
}

model BusKorda {
    id String @id @default(uuid())

    busId String
    bus   Bus    @relation(fields: [busId], references: [id], onDelete: Cascade)

    kordaId String
    korda   Korda  @relation(fields: [kordaId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())

    @@unique([busId, kordaId])
    @@index([busId])
    @@index([kordaId])
}

model DropPoint {
    id    String @id @default(uuid())
    name  String
    price Int    @default(0)

    kordaId String
    korda   Korda  @relation(fields: [kordaId], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    outboundRegistrations Registration[] @relation("OutboundDropPoint")
    returnRegistrations   Registration[] @relation("ReturnDropPoint")

    @@index([kordaId])
}

enum RegistrationStatus {
    DRAFT
    CONFIRMED
    CANCELLED
    PARTIAL_CANCEL // When only return journey is cancelled
}

model Registration {
    id String @id @default(uuid())

    // Event relation
    eventId String
    event   Event  @relation(fields: [eventId], references: [id])

    // Student relation
    studentId String
    student   Student @relation(fields: [studentId], references: [id])

    // Outbound Journey (Pulang ke rumah) - OPTIONAL for return-only registration
    outboundKordaId     String?
    outboundKorda       Korda?     @relation("OutboundKorda", fields: [outboundKordaId], references: [id])
    outboundDropPointId String?
    outboundDropPoint   DropPoint? @relation("OutboundDropPoint", fields: [outboundDropPointId], references: [id])
    outboundDate        DateTime?
    outboundPaid        Boolean    @default(false)
    outboundBusId       String? // Manual bus assignment for outbound
    outboundBus         Bus?       @relation("OutboundBus", fields: [outboundBusId], references: [id], onDelete: SetNull)

    // Return Journey (Kembali ke pondok) - OPTIONAL when cancelled
    returnKordaId     String?
    returnKorda       Korda?     @relation("ReturnKorda", fields: [returnKordaId], references: [id])
    returnDropPointId String?
    returnDropPoint   DropPoint? @relation("ReturnDropPoint", fields: [returnDropPointId], references: [id])
    returnDate        DateTime?
    returnPaid        Boolean    @default(false)
    returnBusId       String? // Manual bus assignment for return
    returnBus         Bus?       @relation("ReturnBus", fields: [returnBusId], references: [id], onDelete: SetNull)

    // Status
    status RegistrationStatus @default(CONFIRMED)

    // Flags
    kordaChanged         Boolean @default(false) // True if different from student's original Korda
    kordaChangeConfirmed Boolean @default(false) // Confirmation for Korda change

    // Cancellation & Refund tracking
    cancelledAt  DateTime?
    cancelReason String?
    refundAmount Int?      @default(0)

    // Registration info
    registrarName  String
    registrarPhone String
    notes          String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([eventId, studentId]) // One registration per student per event
    @@index([eventId])
    @@index([studentId])
    @@index([status])
    @@index([outboundKordaId])
    @@index([returnKordaId])
    @@index([outboundBusId])
    @@index([returnBusId])
}
