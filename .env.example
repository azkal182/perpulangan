DATABASE_URL=

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Logging Configuration
# Server-side log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# Client-side log level (must be NEXT_PUBLIC_ prefix for client visibility)
NEXT_PUBLIC_LOG_LEVEL=info

NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_API_KEY=

# Private Supabase Storage bucket for payment and refund evidence.
# Keep the service role key server-side; never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PAYMENT_EVIDENCE_BUCKET=payment-evidence

TRACK_API_URL=
TRACK_ADMIN_API_KEY=
