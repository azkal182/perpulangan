# ============================================================
# Environment template untuk Docker development
# Copy file ini ke .env: cp .env.docker .env
# Lalu isi nilai yang kosong sesuai kebutuhan
# ============================================================

# Database — sudah dikonfigurasi untuk service "db" di docker-compose.yml
# Nilai ini akan di-override oleh environment di docker-compose.yml,
# tapi tetap diisi sebagai fallback / untuk prisma CLI di luar container
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/perpulangan

# Auth — WAJIB diisi dengan random string yang kuat
BETTER_AUTH_SECRET=ganti_dengan_random_string_minimal_32_karakter
BETTER_AUTH_URL=http://localhost:3000

# Logging
LOG_LEVEL=debug
NEXT_PUBLIC_LOG_LEVEL=info

# API Eksternal — isi sesuai kebutuhan
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_API_KEY=

TRACK_API_URL=
TRACK_ADMIN_API_KEY=
